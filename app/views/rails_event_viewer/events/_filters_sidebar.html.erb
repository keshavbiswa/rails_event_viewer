<div class="bg-white rounded-lg shadow p-5 space-y-5">
  <h2 class="font-medium text-gray-900">Filters</h2>

  <%= form_with url: rails_event_viewer.events_path, method: :get, class: "space-y-5" do |f| %>
    <%= f.hidden_field :q, value: @query if @query %>

    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Event Name</label>
      <%= f.select :name,
          options_for_select([["All events", ""]] + event_names.map { |n| [n, n] }, params[:name]),
          {},
          class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
    </div>

    <fieldset>
      <legend class="block text-sm font-medium text-gray-700 mb-2">Date Range</legend>
      <div class="space-y-2">
        <%= f.date_field :start_date,
            value: @start_date,
            placeholder: "From",
            aria: { label: "From date" },
            class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
        <%= f.date_field :end_date,
            value: @end_date,
            placeholder: "To",
            aria: { label: "To date" },
            class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
      </div>
    </fieldset>

    <fieldset>
      <legend class="block text-sm font-medium text-gray-700 mb-1">Tag</legend>
      <p class="text-xs text-gray-500 mb-2">Filter by event tags (e.g., env, user_id)</p>
      <%= f.text_field :tag_key,
          value: params[:tag_key],
          placeholder: "e.g., environment",
          aria: { label: "Tag key" },
          class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 mb-2" %>
      <%= f.text_field :tag_value,
          value: params[:tag_value],
          placeholder: "e.g., production",
          aria: { label: "Tag value" },
          class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
    </fieldset>

    <fieldset>
      <legend class="block text-sm font-medium text-gray-700 mb-1">Context</legend>
      <p class="text-xs text-gray-500 mb-2">Filter by request context (e.g., request_id)</p>
      <%= f.text_field :context_key,
          value: params[:context_key],
          placeholder: "e.g., request_id",
          aria: { label: "Context key" },
          class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 mb-2" %>
      <%= f.text_field :context_value,
          value: params[:context_value],
          placeholder: "e.g., abc-123",
          aria: { label: "Context value" },
          class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
    </fieldset>

    <div class="flex space-x-3 pt-3">
      <%= f.submit "Apply",
          class: "flex-1 bg-indigo-600 text-white px-4 py-2.5 rounded-md font-medium hover:bg-indigo-700 cursor-pointer" %>
      <%= link_to "Clear",
          rails_event_viewer.events_path,
          class: "flex-1 text-center bg-gray-100 text-gray-700 px-4 py-2.5 rounded-md font-medium hover:bg-gray-200" %>
    </div>
  <% end %>
</div>
