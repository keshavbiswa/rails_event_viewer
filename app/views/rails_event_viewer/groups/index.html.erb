<% content_for(:title, "Groups - Rails Event Viewer") %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Event Groups</h1>
      <p class="mt-1 text-sm text-gray-500">
        Track related events grouped by context or tags
      </p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-4">
    <%= form_with url: rails_event_viewer.groups_path, method: :get, class: "flex items-center space-x-4" do |f| %>
      <div class="flex items-center space-x-2">
        <%= f.label :key, "Group by:", class: "text-sm font-medium text-gray-700" %>
        <%= f.select :key,
            options_for_select(@group_keys.map { |k| [k.to_s.titleize, k] }, @selected_key),
            {},
            class: "rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
      </div>

      <div class="flex items-center space-x-2">
        <%= f.label :source, "Source:", class: "text-sm font-medium text-gray-700" %>
        <%= f.select :source,
            options_for_select([["Context", :context], ["Tags", :tags]], @source),
            {},
            class: "rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3" %>
      </div>

      <%= f.submit "Apply",
          class: "bg-indigo-600 text-white px-4 py-2 rounded-md font-medium hover:bg-indigo-700 cursor-pointer" %>
    <% end %>
  </div>

  <% if @group_keys.empty? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">No group keys configured</h3>
          <p class="mt-1 text-sm text-yellow-700">
            Configure group keys in your initializer:
            <code class="bg-yellow-100 px-1 rounded">config.group_keys = [:request_id, :order_id]</code>
          </p>
        </div>
      </div>
    </div>
  <% elsif @groups.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= @selected_key.to_s.titleize %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Events</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duration</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @groups.each do |group| %>
            <% duration = group[:last_event_at] && group[:first_event_at] ? group[:last_event_at] - group[:first_event_at] : nil %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to rails_event_viewer.group_path(value: group[:value], key: @selected_key, source: @source),
                    class: "text-indigo-600 hover:text-indigo-900 font-medium" do %>
                  <code class="text-sm bg-gray-100 px-2 py-1 rounded"><%= group[:value] %></code>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= number_with_delimiter(group[:count]) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if group[:first_event_at] %>
                  <%= time_ago_with_title(group[:first_event_at]) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if group[:last_event_at] %>
                  <%= time_ago_with_title(group[:last_event_at]) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if duration %>
                  <%= format_duration(duration) %>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow px-6 py-12 text-center text-gray-500">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No groups found</h3>
      <p class="mt-1 text-sm text-gray-500">
        No events with <code class="bg-gray-100 px-1 rounded"><%= @selected_key %></code> in their <%= @source %> data.
      </p>
    </div>
  <% end %>
</div>
