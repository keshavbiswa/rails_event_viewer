<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
  <title><%= content_for(:title) || "Rails Event Viewer" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "rails_event_viewer/application", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "rails_event_viewer/chart.umd.min",
        "rails_event_viewer/chartjs-adapter-date-fns.bundle.min",
        "rails_event_viewer/chartkick.min",
        "rails_event_viewer/application",
        defer: true,
        nonce: true %>
</head>
<body class="h-full">
  <div class="min-h-full">
    <%= render "rails_event_viewer/shared/navigation" %>

    <main class="py-6">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <% if notice.present? %>
          <div class="mb-4 rounded-md bg-green-50 p-4">
            <p class="text-sm font-medium text-green-800"><%= notice %></p>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="mb-4 rounded-md bg-red-50 p-4">
            <p class="text-sm font-medium text-red-800"><%= alert %></p>
          </div>
        <% end %>

        <% if RailsEventViewer.storage_adapter == :active_record && !persistence_supported? %>
          <div class="mb-4 rounded-md bg-red-50 p-4" role="alert">
            <p class="text-sm font-medium text-red-800">
              The events table is missing, so no events are being saved. Run <code>bin/rails generate rails_event_viewer:install</code> and <code>bin/rails db:migrate</code>, then restart the app.
            </p>
          </div>
        <% end %>

        <% if RailsEventViewer.sample_rate.to_f < 1.0 %>
          <div class="mb-4 rounded-md bg-yellow-50 border border-yellow-200 p-4">
            <p class="text-sm font-medium text-yellow-800">
              Sampling is on: only <%= number_to_percentage(RailsEventViewer.sample_rate.to_f * 100, precision: 3, significant: true, strip_insignificant_zeros: true) %> of events are recorded, so timelines can have gaps.
            </p>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </div>
</body>
</html>
